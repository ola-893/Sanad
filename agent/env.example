# Pinata IPFS Configuration
PINATA_JWT=your_pinata_jwt_token_here

# IPFS Configuration
USE_LOCAL_IPFS=false
IPFS_API_URL=http://localhost:5001/api/v0

# Phoenix Arize Configuration (observability)
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_SERVICE_NAME=sanad-gold-evaluator

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LLM_MODEL=llama3.1:8b

# FastForex API for live Forex & Gold Rates
FASTFOREX_API_KEY=your_fastforex_api_key_here

# Gold Evaluation Parameters
JEWELLERY_HAIRCUT_BPS=500
BAR_HAIRCUT_BPS=100
MAX_SAFE_LTV=0.80
MARGIN_CALL_LTV=0.85
VOL_WINDOW=30
VOL_THRESHOLD=0.05
TENURE_LIMIT_DAYS=180
PRICE_DEVIATION_THRESHOLD=5.0

# Logging
LOG_LEVEL=INFO

# Sanad API Configuration
SANAD_API_BASE=http://localhost:8000
SANAD_API_KEY=your_jwt_token_here

# Encryption Configuration
IPFS_ENCRYPTION_KEY=your_64_character_hex_encryption_key_here